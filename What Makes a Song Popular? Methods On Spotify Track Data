import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import matplotlib.patches as mpatches
from scipy import stats
from sklearn.model_selection import train_test_split
import warnings

warnings.filterwarnings("ignore")

# ── Style ─────────────────────────────────────────────────────────────────────
plt.rcParams.update({
    "figure.dpi"       : 150,
    "font.family"      : "serif",
    "axes.spines.top"  : False,
    "axes.spines.right": False,
    "axes.titlesize"   : 12,
    "axes.labelsize"   : 10,
    "xtick.labelsize"  : 9,
    "ytick.labelsize"  : 9,
})

GREEN = "#1ED760"
DARK  = "#191414"
GRAY  = "#787878"
BLUE  = "#1262FF"
RED   = "#E8394A"

# ── Load & split ──────────────────────────────────────────────────────────────
df = pd.read_csv("spotify-tracks-dataset-detailed.csv")
df = df.dropna(subset=["artists", "album_name", "track_name"]).reset_index(drop=True)
df["is_popular"] = (df["popularity"] > 35).astype(int)

# Same stratified 70/15/15 split used across all chapters
X_all = df[["loudness"]]
y_all = df["popularity"]
yb    = df["is_popular"]

X_tv, X_test, y_tv, y_test, yb_tv, yb_test = train_test_split(
    X_all, y_all, yb, test_size=0.15, random_state=42, stratify=yb)
X_train, X_val, y_train, y_val, _, _ = train_test_split(
    X_tv, y_tv, yb_tv, test_size=0.15/0.85, random_state=42, stratify=yb_tv)

x_train = X_train["loudness"].values
x_test  = X_test["loudness"].values

# ── Fit SLR on training set ───────────────────────────────────────────────────
slope, intercept, r_val, p_val, se = stats.linregress(x_train, y_train.values)
r2 = r_val ** 2

# Predictions and residuals on training set
y_pred_train = intercept + slope * x_train
resid        = y_train.values - y_pred_train

# Test performance
y_pred_test = intercept + slope * x_test
test_rmse   = np.sqrt(np.mean((y_test.values - y_pred_test) ** 2))
test_r2     = 1 - np.sum((y_test.values - y_pred_test)**2) / \
                  np.sum((y_test.values - y_test.mean())**2)

print(f"Intercept : {intercept:.4f}")
print(f"Slope     : {slope:.4f}")
print(f"R²        : {r2:.5f}")
print(f"Test RMSE : {test_rmse:.4f}")
print(f"Test R²   : {test_r2:.5f}")


# =============================================================================
# FIGURE 1 — Scatter plot with SLR line and 95% confidence band
# =============================================================================
np.random.seed(42)
# Sample 8000 points for visual clarity (full 80k overplots completely)
idx_sample = np.random.choice(len(x_train), size=8000, replace=False)
x_samp = x_train[idx_sample]
y_samp = y_train.values[idx_sample]

# Confidence band: SE of mean prediction
n_train  = len(x_train)
x_mean   = x_train.mean()
ss_x     = np.sum((x_train - x_mean) ** 2)
x_line   = np.linspace(x_train.min(), x_train.max(), 300)
y_line   = intercept + slope * x_line

# Standard error of fitted mean at each x_line point
se_fit  = np.sqrt(
    (np.sum(resid**2) / (n_train - 2)) *
    (1/n_train + (x_line - x_mean)**2 / ss_x)
)
t_crit  = stats.t.ppf(0.975, df=n_train - 2)
ci_lo   = y_line - t_crit * se_fit
ci_hi   = y_line + t_crit * se_fit

fig, ax = plt.subplots(figsize=(10, 5.5), facecolor="white")

# Scatter
ax.scatter(x_samp, y_samp, alpha=0.07, s=6, color=GRAY,
           rasterized=True, label="_nolegend_")

# Confidence band
ax.fill_between(x_line, ci_lo, ci_hi, alpha=0.25, color=BLUE,
                label="95% confidence band")

# Regression line
ax.plot(x_line, y_line, color=BLUE, linewidth=2.2,
        label=f"$\\hat{{y}} = {intercept:.2f} + {slope:.3f} \\times$ loudness")

# Annotation box
ax.text(0.03, 0.93,
        f"$R^2 = {r2:.4f}$\nRMSE (test) $= {test_rmse:.2f}$\n"
        f"$n_{{train}} = {n_train:,}$",
        transform=ax.transAxes, fontsize=9.5,
        verticalalignment="top",
        bbox=dict(facecolor="white", edgecolor=GRAY,
                  boxstyle="round,pad=0.4", alpha=0.9))

ax.set_xlabel("Loudness (dB)")
ax.set_ylabel("Popularity Score (0–100)")
ax.set_title("Simple Linear Regression: Loudness → Popularity\n"
             "(8,000 training points shown; line fit on all 79,799)",
             fontweight="bold")
ax.legend(fontsize=9, loc="lower right")
ax.set_ylim(-5, 105)

plt.tight_layout()
plt.savefig("ch3_scatter.png", dpi=300, bbox_inches="tight")

# =============================================================================
# FIGURE 2 — 4-panel residual diagnostics
